    <string-array name="overlay_delay_titles">
        <item>Take a moment to think...</item>
        <item>Pause and reflect</item>
        <item>Is this intentional?</item>
        <item>Before you scroll...</item>
        <item>A moment of awareness</item>
    </string-array>
