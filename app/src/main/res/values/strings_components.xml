    <!-- Prominent disclosure for the accessibility service (Play policy, docs/play-store.md). -->
    <string name="components_disclosure_title">How Nudge Works</string>
    <string name="components_disclosure_what">Nudge uses Android\'s Accessibility Service to detect which app is currently open on your screen.</string>
    <string name="components_disclosure_why">This lets Nudge show breathing exercises, delays, or blocks when you open apps you\'ve chosen to limit.</string>
    <string name="components_disclosure_reads">Nudge only reads the name of the app in the foreground. It does not read your messages, keystrokes, passwords, or screen content.</string>
    <string name="components_disclosure_local">All data stays on your device. Nudge has no internet permission and cannot send data anywhere.</string>
    <string name="components_disclosure_confirm">I Understand</string>
    <string name="components_disclosure_dismiss">Not Now</string>

