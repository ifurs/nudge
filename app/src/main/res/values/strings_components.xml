    <!-- Usage reminder section shared by both rule editors. -->
    <string name="components_usage_reminder_title">Usage reminder</string>
    <string name="components_usage_reminder_field_label">Remind me after</string>
    <string name="components_usage_reminder_field_supporting">Counts time in the app in one sitting. One heads-up, nothing closes.</string>
    <string name="components_usage_reminder_blocked_warning">Notifications are off for Nudge, so this reminder can\'t reach you. Tap to turn them on.</string>
    <string name="components_usage_reminder_superseded">Auto-kick at %1$d min comes first, so this reminder won\'t show. Set it below %1$d min to get both.</string>
    <string name="components_usage_reminder_info">Get one gentle notification once you\'ve spent this long in the app in one sitting. It doesn\'t close anything, it just lets you know.\n\nIt resets the same way auto-kick does: a short trip to another app keeps the sitting going, a real break (5 minutes or more) starts a new one. If auto-kick by time is set for the same or a shorter time, auto-kick wins and the reminder is skipped.</string>
    <string name="components_usage_reminder_info_apps_only">Apps only: it does not cover the websites below.</string>

