    <!-- Nuke screen -->
    <string name="nuke_title">Nuke</string>
    <string name="nuke_back">Back</string>
    <string name="nuke_apps_title">Apps to nuke</string>
    <string name="nuke_apps_never_listed">Your phone, messages, clock, launcher, keyboard and Settings are never on this list.</string>
    <string name="nuke_search_apps">Search apps…</string>
    <string name="nuke_share_chooser">Save your Nuke code</string>

    <string name="nuke_intro_1">Nuke is a second list, separate from your rules. When it\'s on, those apps don\'t open. At all.</string>
    <string name="nuke_intro_2">You turn it on and off by scanning a code you keep somewhere inconvenient.</string>
    <string name="nuke_intro_3">Lost the code? There\'s an emergency way out: typing 64 characters by hand. It\'s meant to be annoying.</string>

    <plurals name="nuke_status_on">
        <item quantity="one">Nuke is on · %1$d app</item>
        <item quantity="other">Nuke is on · %1$d apps</item>
    </plurals>
