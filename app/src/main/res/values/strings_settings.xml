    <!-- Grayscale setup guide -->
    <string name="settings_gs_title">Grayscale Mode Setup</string>
    <string name="settings_gs_intro_1">Grayscale mode makes your phone screen black-and-white when blocked apps are open, making them less appealing.</string>
    <string name="settings_gs_intro_2">This requires a one-time setup because Android restricts apps from changing display settings directly.</string>
    <string name="settings_gs_option_1">Option 1: Wireless (Android 11+, no computer needed)</string>
    <string name="settings_gs_w_step_1">Go to Settings &gt; About Phone &gt; tap \"Build number\" 7 times to enable Developer Options</string>
    <string name="settings_gs_w_step_2">Go to Settings &gt; Developer Options &gt; enable \"Wireless debugging\"</string>
    <string name="settings_gs_w_step_3">Tap \"Pair device with pairing code\" and note the pairing code and port</string>
    <string name="settings_gs_w_step_4">Open a terminal app (like Termux) and run the pairing command:</string>
    <string name="settings_gs_pair_label">Then enter the pairing code when prompted</string>
    <string name="settings_gs_w_step_5">Then run this command to grant the permission:</string>
    <string name="settings_gs_option_2">Option 2: With a Computer</string>
    <string name="settings_gs_c_step_1">Install ADB on your computer (search \"install adb\" for your OS)</string>
    <string name="settings_gs_c_step_2">Enable USB Debugging on your phone (Settings &gt; Developer Options &gt; USB Debugging)</string>
    <string name="settings_gs_c_step_3">Connect your phone via USB</string>
    <string name="settings_gs_c_step_4">Run this command on your computer:</string>
    <string name="settings_gs_done">That\'s it! One-time setup. Grayscale will work automatically after this.</string>
