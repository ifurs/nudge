    <string name="settings_gs_granted_body">Grayscale mode is ready to use. Enable it per-app in rule settings.</string>
    <string name="settings_gs_not_granted_title">Not Granted</string>
    <string name="settings_gs_not_granted_body">Follow the guide below to enable grayscale.</string>
