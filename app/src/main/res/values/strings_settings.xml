    <!-- Content filter -->
    <string name="settings_cf_block_title">Block restricted websites</string>
    <string name="settings_cf_block_desc">Blocks adult and explicit sites and searches. Works in supported browsers.</string>
    <string name="settings_cf_strict_title">Strict keyword matching</string>
    <string name="settings_cf_strict_desc">Also blocks searches with ambiguous words. May catch innocent searches; you can add exceptions.</string>
    <string name="settings_blocklist_title">Blocked words &amp; sites</string>
    <string name="settings_blocklist_subtitle">Words and phrases block pages and searches containing them. A site blocks pages on that site and its subdomains.</string>
    <string name="settings_blocklist_subtitle_strict">Words and phrases block pages and searches containing them. A site blocks pages on that site and its subdomains. Removing one requires the unlock challenge.</string>
    <string name="settings_blocklist_unlock_prompt">Remove a blocked word or site</string>
    <string name="settings_blocklist_empty">Nothing blocked yet.</string>
    <string name="settings_allowlist_title">Allowed words &amp; sites</string>
    <string name="settings_allowlist_subtitle">Words here excuse strict keyword matches and your blocked words. An allowed site skips both on that site.</string>
    <string name="settings_allowlist_subtitle_strict">Words here excuse strict keyword matches and your blocked words. An allowed site skips both on that site. Adding one requires the unlock challenge.</string>
