<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Deliberately the SAME as the English label. The strict-mode escape guard finds Nudge's own
         page in the system Settings by this exact text, and Settings draws the label in the SYSTEM
         language while Nudge may run in another (per-app language). One label means the match cannot
         fall between the two. -->
    <string name="app_name">Nudge - App Blocker</string>
    <string name="accessibility_service_description">Nudge відстежує, який застосунок відкрито на передньому плані, щоб застосовувати ваші правила блокування. Жодні дані не залишають ваш пристрій.</string>
    <string name="notification_channel_name">Моніторинг Nudge</string>
    <string name="notification_channel_description">Показує, коли Nudge активно стежить за застосунками</string>

    <string name="bounce_checkin_channel_name">Нагадування про метання</string>
    <string name="bounce_checkin_channel_description">Нагадування, коли ви метаєтеся між застосунками чи заблокованими сайтами після блокування</string>
    <string name="use_reminder_channel_name">Нагадування про час</string>
    <string name="use_reminder_channel_description">Попередження через заданий час у застосунку, якщо цього вимагає правило</string>

    <string name="protection_alert_channel_name">Сповіщення про захист</string>
    <string name="protection_alert_channel_description">Повідомляє, якщо блокування перестає працювати</string>
    <string name="protection_alert_accessibility_title">Nudge перестав блокувати</string>
    <string name="protection_alert_accessibility_body">Дозвіл служби спеціальних можливостей для Nudge вимкнено, тож застосунки не блокуються. Торкніться, щоб увімкнути його знову.</string>
    <string name="protection_alert_crashed_title">Nudge перестав блокувати</string>
    <string name="protection_alert_crashed_body">Телефон зупинив Nudge. Перемикач і далі показує «увімкнено», тож блокування само не відновиться — вимкніть і знову ввімкніть Nudge у налаштуваннях спеціальних можливостей або перезавантажте телефон. Торкніться, щоб побачити кроки.</string>
    <string name="protection_alert_service_title">Телефон постійно зупиняє Nudge</string>
    <string name="protection_alert_service_body">Nudge зупиняється у фоновому режимі, тож блокування може працювати нестабільно. Торкніться, щоб перевірити стан.</string>
    <string name="protection_alert_blocked_title">Nudge не може перезапуститися сам</string>
    <string name="protection_alert_blocked_body">Телефон не дає Nudge перезапускатися самостійно, тож блокування може працювати нестабільно. Якщо відкрити Nudge, він запуститься знову. Увімкнений дозвіл «Показ поверх інших застосунків» допомагає йому перезапускатися самому. Торкніться, щоб побачити кроки.</string>

